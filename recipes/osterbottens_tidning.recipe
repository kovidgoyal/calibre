from calibre.web.feeds.news import BasicNewsRecipe


class OsterbottensTidning(BasicNewsRecipe):
    title = 'Österbottens Tidning – RSS-översikt'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Österbottens Tidning'
    description = 'Rubriker, RSS-text och länkar från Österbottens Tidning.'
    language = 'sv'
    encoding = 'utf-8'
    oldest_article = 7
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    timeout = 30
    no_stylesheets = True
    use_embedded_content = True
    remove_empty_feeds = True
    ignore_duplicate_articles = {'url'}

    feeds = [
        ('Senaste nytt', 'https://www.osterbottenstidning.fi/feeds/feed.xml'),
    ]
