from calibre.web.feeds.news import BasicNewsRecipe


class SvenskaEkonominyheter(BasicNewsRecipe):
    __author__ = 'Jonatan Nyberg'
    title = 'Svenska ekonominyheter'
    description = 'Rubriker, RSS-ingresser och länkar från svenska ekonomikällor.'
    language = 'sv'
    oldest_article = 5
    max_articles_per_feed = 8
    simultaneous_downloads = 2
    timeout = 30
    no_stylesheets = True
    use_embedded_content = True
    remove_empty_feeds = True
    ignore_duplicate_articles = {'url'}

    feeds = [
        ('SVT Ekonomi', 'https://www.svt.se/nyheter/ekonomi/rss.xml'),
        ('Dagens PS', 'https://www.dagensps.se/feed/'),
        ('Realtid', 'https://www.realtid.se/feed/'),
        ('Riksbanken – pressmeddelanden', 'https://www.riksbank.se/sv/rss/pressmeddelanden/'),
    ]
