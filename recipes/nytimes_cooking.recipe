#!/usr/bin/env python
# vim:fileencoding=utf-8
from calibre.web.feeds.news import BasicNewsRecipe, prefixed_classes


class NYTCooking(BasicNewsRecipe):
    title = 'NY Times Cooking'
    description = 'NY Times Cooking Magazine'
    __author__ = 'gourav'
    language = 'en_US'
    encoding = 'utf-8'
    oldest_article = 2
    max_articles_per_feed = 30
    remove_attributes = ['style']
    no_stylesheets = True
    ignore_duplicate_articles = {'url'}
    keep_only_tags = [
        prefixed_classes('pagecontent_recipe-wrap__'),
    ]
    remove_tags = [
        prefixed_classes(
            'adunit_ad-unit__ recipeintro_tools-block__ notessection_notesPrintLayout__ notessection_notesSection__'
            ' ratingssection_ratingsSection__ ingredients_buttons__'
        ),
        dict(name='source'),
    ]

    def parse_index(self):
        index_url = 'https://cooking.nytimes.com/topics/what-to-cook-this-week'
        soup = self.index_to_soup(index_url)

        feed = []
        for card in soup.findAll(**prefixed_classes('recipecard_recipeCard__')):
            link = card.find('a', href=True)
            title = card.find('h3')
            if link is None or title is None:
                # The carousels hold the odd card that advertises a collection
                # rather than a recipe, and those have neither
                continue
            url = link['href']
            if url.startswith('/'):
                url = 'https://cooking.nytimes.com' + url
            author = card.find(**prefixed_classes('recipecard_byline__'))
            feed.append({
                'url': url,
                'title': title.text.strip(),
                'author': author.text.strip() if author is not None else 'Unknown',
            })
        if not feed:
            raise ValueError(f'Found no recipes on {index_url}, the site layout has probably changed')

        return [('Recipes', feed)]
