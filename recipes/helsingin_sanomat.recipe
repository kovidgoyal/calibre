from calibre.web.feeds.news import BasicNewsRecipe


class HelsinginSanomat(BasicNewsRecipe):
    title = 'Helsingin Sanomat – RSS-kooste'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Helsingin Sanomat'
    description = 'Julkisen RSS-syötteen otsikot, tiivistelmät ja linkit. Ei tilaaja-artikkelien kokotekstiä.'
    language = 'fi'
    encoding = 'utf-8'
    oldest_article = 7
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    timeout = 30
    no_stylesheets = True
    use_embedded_content = True
    remove_empty_feeds = True
    ignore_duplicate_articles = {'url'}

    feeds = [
        ('Tuoreimmat', 'https://www.hs.fi/rss/tuoreimmat.xml'),
    ]
