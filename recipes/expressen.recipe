from calibre.web.feeds.news import BasicNewsRecipe


class Expressen(BasicNewsRecipe):
    __author__ = 'Jonatan Nyberg'
    title = 'Expressen'
    publisher = 'Expressen'
    description = 'Nyheter från Expressen.'
    language = 'sv'
    oldest_article = 2
    max_articles_per_feed = 15
    simultaneous_downloads = 2
    timeout = 30
    auto_cleanup = True
    no_stylesheets = True
    use_embedded_content = False
    ignore_duplicate_articles = {'url'}

    feeds = [
        ('Nyheter', 'https://feeds.expressen.se/nyheter/'),
    ]
