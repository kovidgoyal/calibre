from calibre.web.feeds.news import BasicNewsRecipe


class DagensArena(BasicNewsRecipe):
    __author__ = 'Jonatan Nyberg'
    title = 'Dagens Arena'
    publisher = 'Dagens Arena'
    description = 'Nyheter, granskningar och opinion från Dagens Arena.'
    language = 'sv'
    encoding = 'utf-8'
    oldest_article = 7
    max_articles_per_feed = 20
    simultaneous_downloads = 2
    delay = 1
    timeout = 30
    auto_cleanup = True
    no_stylesheets = True
    use_embedded_content = False
    remove_empty_feeds = True
    ignore_duplicate_articles = {'url'}

    feeds = [
        ('Senaste nytt', 'https://www.dagensarena.se/feed/'),
    ]
