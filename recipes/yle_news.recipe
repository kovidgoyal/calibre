from calibre.web.feeds.news import BasicNewsRecipe


class YleNews(BasicNewsRecipe):
    title = 'Yle News'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Yle'
    description = 'News about Finland in English from Yle. Downloads article pages; audio and video are not transcribed.'
    language = 'en'
    encoding = 'utf-8'
    oldest_article = 7
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    timeout = 30
    auto_cleanup = True
    no_stylesheets = True
    use_embedded_content = False
    remove_empty_feeds = True
    ignore_duplicate_articles = {'url'}

    feeds = [('Latest news', 'https://yle.fi/rss/news')]
