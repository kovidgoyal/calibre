#!/usr/bin/env python

__license__ = 'GPL v3'
'''
Hacker News
'''
import json
import re
from urllib.parse import parse_qs, urlparse

from calibre import prepare_string_for_xml
from calibre.ptempfile import PersistentTemporaryFile
from calibre.web.feeds.news import BasicNewsRecipe

HN_URL_RE = re.compile(r'https://news\.ycombinator\.com/item\?id=\d+')
HN_COMMENTS_URL_RE = re.compile(r'Comments URL:\s*<a [^>]*href="(https://news\.ycombinator\.com/item\?id=\d+)"')
# news.ycombinator.com rejects automated requests with HTTP 419, so story and
# comment data is fetched from the Algolia HN API instead, which returns the
# full comment tree for a story in a single JSON response.
HN_API_URL = 'https://hn.algolia.com/api/v1/items/{}'
MAX_INDENT_LEVEL = 10


def esc(text):
    return prepare_string_for_xml(str(text or ''))


class HNWithCommentsLink(BasicNewsRecipe):
    title = 'HN With Actual Comments'
    __author__ = 'Tom Scholl & David Kerschner'
    description = 'Hacker News, run by Y Combinator. Anything that good hackers would find interesting, with a focus on programming and startups.'
    publisher = 'Y Combinator'
    category = 'news, programming, it, technology'
    delay = 1
    max_articles_per_feed = 20
    oldest_article = 3
    use_embedded_content = False
    no_stylesheets = True
    encoding = 'utf-8'
    language = 'en'
    requires_version = (0, 8, 16)

    feeds = [('Hacker News Frontpage', 'https://hnrss.org/frontpage'), ('Ask Hacker News', 'https://hnrss.org/ask')]

    temp_files = []
    articles_are_obfuscated = True

    def _find_hn_url(self, article):
        # hnrss.org sets <guid> to the HN thread URL, so article.id is normally
        # that URL. Fall back to scraping the description HTML for
        # "Comments URL: <a href='...'>" if the id isn't populated.
        aid = getattr(article, 'id', None)
        if aid and isinstance(aid, str):
            m = HN_URL_RE.match(aid)
            if m:
                return m.group(0)
        for attr in ('summary', 'text_summary', 'content'):
            text = getattr(article, attr, None)
            if text:
                m = HN_COMMENTS_URL_RE.search(text)
                if m:
                    return m.group(1)
                m = HN_URL_RE.search(text)
                if m:
                    return m.group(0)
        return None

    def parse_feeds(self):
        feeds = super().parse_feeds()
        # Build a map from article URL to HN thread URL so that when the article
        # <link> points to an external site we can still fetch the HN comments.
        self.url_to_comments = {}
        for feed in feeds:
            for article in feed.articles:
                hn_url = self._find_hn_url(article)
                if hn_url and article.url != hn_url:
                    self.url_to_comments[article.url] = hn_url
        if feeds:
            self.hn_articles = feeds[0].articles
        return feeds

    def get_readable_content(self, url):
        self.log('get_readable_content(' + url + ')')
        br = self.get_browser()
        f = br.open(url)
        html = f.read()
        f.close()
        return self.extract_readable_article(html, url)

    def hn_item_id(self, url):
        ids = parse_qs(urlparse(url).query).get('id')
        if not ids:
            raise ValueError('Not a Hacker News item URL: ' + url)
        return ids[0]

    def fetch_hn_item(self, url):
        api_url = HN_API_URL.format(self.hn_item_id(url))
        self.log('fetch_hn_item(' + api_url + ')')
        return json.loads(self.index_to_soup(api_url, raw=True))

    def hn_subtext(self, item):
        n = self.count_comments(item.get('children') or ())
        return '{} points by {} | {} comments'.format(item.get('points') or 0, item.get('author') or '', n)

    def count_comments(self, children):
        return sum(1 + self.count_comments(c.get('children') or ()) for c in children if c.get('text'))

    def render_comments(self, children, depth=0):
        parts = []
        for c in children:
            text = c.get('text')
            if text:  # deleted and dead comments have no text
                indent = min(depth, MAX_INDENT_LEVEL) * 1.5
                parts.append('<h4 style="margin-left: {0}em">{1}</h4><div style="margin-left: {0}em">{2}</div>'.format(indent, esc(c.get('author')), text))
            parts.extend(self.render_comments(c.get('children') or (), depth + 1))
        return parts

    def get_hn_comments_html(self, url):
        # Comments-only fragment, used when the article's main content comes
        # from an external site and we want to append the HN discussion.
        self.log('get_hn_comments_html(' + url + ')')
        item = self.fetch_hn_item(url)
        comments = ''.join(self.render_comments(item.get('children') or ()))
        return '<hr/><h2>Hacker News Discussion</h2><p><em>' + esc(self.hn_subtext(item)) + '</em></p>' + comments

    def get_hn_content(self, url):
        self.log('get_hn_content(' + url + ')')
        item = self.fetch_hn_item(url)
        title = esc(item.get('title'))
        link = item.get('url') or url
        readable_link = link.rpartition('http://')[2].rpartition('https://')[2]
        title_content = '<div>' + item['text'] + '</div>' if item.get('text') else ''
        comments = ''.join(self.render_comments(item.get('children') or ()))
        body = (
            '<h3>'
            + title
            + '</h3><p><a href="'
            + esc(link)
            + '">'
            + esc(readable_link)
            + '</a><br/><strong>'
            + esc(self.hn_subtext(item))
            + '</strong></p>'
            + title_content
            + '<hr/><h3>Comments</h3>'
            + comments
        )
        return '<html><head><title>' + title + '</title></head><body>' + body + '</body></html>'

    def get_obfuscated_article(self, url):
        self.log('get_obfuscated_article with url=' + url)
        if url.startswith('https://news.ycombinator.com'):
            content = self.get_hn_content(url)
        else:
            is_image = False
            for ext in ['.jpg', '.png', '.svg', '.gif', '.jpeg', '.tiff', '.bmp']:
                if url.endswith(ext):
                    is_image = True
                    break

            if is_image:
                self.log('using image_content (' + url + ')')
                content = '<html><body><img src="' + url + '"></body></html>'
            else:
                try:
                    content = self.get_readable_content(url)
                except Exception as e:
                    # Many linked sites block automated downloads, keep the
                    # article so that at least the HN discussion is included
                    self.log.warn('Failed to download article from', url, 'with error:', e)
                    content = '<html><body><p>Could not download article from <a href="{0}">{0}</a></p></body></html>'.format(esc(url))

            hn_url = self.url_to_comments.get(url)
            if hn_url:
                try:
                    comments_html = self.get_hn_comments_html(hn_url)
                except Exception as e:
                    self.log.warn('Failed to download Hacker News comments from', hn_url, 'with error:', e)
                    comments_html = '<hr/><p><a href="{0}">Hacker News Discussion</a></p>'.format(esc(hn_url))
                if isinstance(content, bytes):
                    content = content.decode('utf-8', 'replace')
                if '</body>' in content:
                    content = content.replace('</body>', comments_html + '</body>', 1)
                else:
                    content = content + comments_html

        if not isinstance(content, bytes):
            content = content.encode('utf-8')
        self.temp_files.append(PersistentTemporaryFile('_fa.html'))
        self.temp_files[-1].write(content)
        self.temp_files[-1].close()
        return self.temp_files[-1].name

    def is_link_wanted(self, url, tag):
        return not url.endswith('.pdf')

    def prettyify_url(self, url):
        return urlparse(url).hostname

    def populate_article_metadata(self, article, soup, first):
        article.text_summary = self.prettyify_url(article.url)
        article.summary = article.text_summary
