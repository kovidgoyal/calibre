from calibre.web.feeds.news import BasicNewsRecipe


class YleNovosti(BasicNewsRecipe):
    title = 'Новости Yle'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Yle'
    description = 'Новости Финляндии на русском языке от Yle. Загружаются тексты статей; аудио и видео не расшифровываются.'
    language = 'ru'
    encoding = 'utf-8'
    oldest_article = 7
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    timeout = 30
    auto_cleanup = True
    no_stylesheets = True
    use_embedded_content = False
    remove_empty_feeds = True
    ignore_duplicate_articles = {'url'}

    feeds = [('Последние новости', 'https://yle.fi/rss/novosti')]
