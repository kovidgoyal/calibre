import re
from urllib.parse import urljoin, urlsplit, urlunsplit

from calibre.web.feeds.news import BasicNewsRecipe


class Meanraatio(BasicNewsRecipe):
    title = 'Meänraatio – meänkieli och svenska'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Meänraatio'
    description = 'Publicerade nyhetstexter på meänkieli och svenska. Ljudinslag transkriberas inte.'
    language = 'fit'
    encoding = 'utf-8'
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    timeout = 30
    auto_cleanup = True
    no_stylesheets = True
    use_embedded_content = False
    ignore_duplicate_articles = {'url'}

    def parse_index(self):
        index_url = 'https://www.sverigesradio.se/meanraatio'
        soup = self.index_to_soup(index_url)
        main = soup.find('main') or soup.find(attrs={'role': 'main'}) or soup
        articles = {}
        for link in main.find_all('a', href=True):
            parsed = urlsplit(urljoin(index_url, link['href']))
            if parsed.scheme != 'https' or parsed.netloc not in {'sverigesradio.se', 'www.sverigesradio.se'}:
                continue
            if not re.fullmatch(r'/artikel/[^/]+/?', parsed.path):
                continue
            heading = link.find(['h2', 'h3', 'h4']) or link.find_parent(['h2', 'h3', 'h4'])
            if heading is None:
                continue
            title = heading.get_text(' ', strip=True)
            if title:
                url = urlunsplit(('https', 'www.sverigesradio.se', parsed.path.rstrip('/'), '', ''))
                articles.setdefault(url, {'title': title, 'url': url})
        if not articles:
            self.abort_recipe_processing('Hittade inga artiklar på Meänraatios förstasida.')
        return [('Meänraatio', list(articles.values())[: self.max_articles_per_feed])]

    def preprocess_html(self, soup):
        for heading in soup.find_all('h1'):
            if 'det här är en reservsida' in heading.get_text(' ', strip=True).casefold():
                raise ValueError('Sveriges Radio returned its temporary outage page')
        return soup
