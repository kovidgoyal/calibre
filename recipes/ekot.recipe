from urllib.parse import urljoin, urlsplit, urlunsplit

from calibre.web.feeds.news import BasicNewsRecipe


class Ekot_SE(BasicNewsRecipe):
    title = 'Ekot'
    __author__ = 'Joakim Lindskog'
    description = 'Nyheter från Ekot, Utrikes och Radiosporten.'
    publisher = 'Ekot'
    category = 'news, politics, Sweden'
    oldest_article = 7
    delay = 1
    timeout = 30
    max_articles_per_feed = 100
    no_stylesheets = True
    use_embedded_content = False
    auto_cleanup = True
    encoding = 'utf-8'
    language = 'sv'

    conversion_options = {'comment': description, 'tags': category, 'publisher': publisher, 'language': language}

    sections = [
        ('Ekot', 'https://www.sverigesradio.se/nyheter/ekot'),
        ('Utrikes', 'https://www.sverigesradio.se/utrikes'),
        ('Radiosporten', 'https://www.sverigesradio.se/sport'),
    ]

    def parse_index(self):
        sections = []
        for name, url in self.sections:
            try:
                soup = self.index_to_soup(url)
            except (OSError, RuntimeError) as exc:
                self.log.warning(f'Kunde inte hämta {name}: {exc}')
                continue

            articles = {}
            main = soup.find('main') or soup.find(attrs={'role': 'main'}) or soup
            for link in main.find_all('a', href=True):
                article_url = urlsplit(urljoin(url, link['href']))
                if (
                    article_url.scheme != 'https'
                    or article_url.netloc not in {'www.sverigesradio.se', 'sverigesradio.se'}
                    or not article_url.path.startswith('/artikel/')
                ):
                    continue

                path = article_url.path.rstrip('/')
                if path == '/artikel':
                    continue
                article_url = urlunsplit(('https', 'www.sverigesradio.se', path, '', ''))

                heading = link.find(['h2', 'h3', 'h4']) or link.find_parent(['h2', 'h3', 'h4'])
                title = (heading or link).get_text(' ', strip=True)
                if title and (heading or article_url not in articles):
                    articles[article_url] = {'title': title, 'url': article_url}

            if articles:
                sections.append((name, list(articles.values())))
            else:
                self.log.warning(f'Hittade inga artikellänkar i {name}.')

        if not sections:
            self.abort_recipe_processing('Hittade inga artiklar på Sveriges Radios nyhetssidor.')
        return sections
