from calibre.web.feeds.news import BasicNewsRecipe


class Avvir(BasicNewsRecipe):
    title = 'Ávvir (RSS)'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Ávvir'
    description = 'Northern Sami headlines, feed text and article links from Ávvir.'
    language = 'sme'
    encoding = 'utf-8'
    oldest_article = 7
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    timeout = 30
    no_stylesheets = True
    use_embedded_content = True
    remove_empty_feeds = True
    ignore_duplicate_articles = {'url'}

    feeds = [('Ođđasat', 'https://www.avvir.no/feed/')]
