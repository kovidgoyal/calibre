from urllib.parse import urljoin, urlsplit, urlunsplit

from calibre.web.feeds.news import BasicNewsRecipe


class AlandsRadio(BasicNewsRecipe):
    title = 'Ålands Radio'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Ålands Radio & TV'
    description = 'Nyhetstexter från Ålands Radios nyhetssida.'
    language = 'sv'
    encoding = 'utf-8'
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    timeout = 30
    auto_cleanup = True
    no_stylesheets = True
    use_embedded_content = False
    ignore_duplicate_articles = {'url'}

    def parse_index(self):
        index_url = 'https://alandsradio.ax/nyheter'
        soup = self.index_to_soup(index_url)
        articles = {}
        for link in soup.find_all('a', href=True):
            parsed = urlsplit(urljoin(index_url, link['href']))
            if parsed.scheme != 'https' or parsed.netloc not in {'alandsradio.ax', 'www.alandsradio.ax'}:
                continue
            path = parsed.path.rstrip('/')
            if not path.startswith('/nyheter/') or '/' in path[len('/nyheter/') :]:
                continue
            heading = link.find(['h2', 'h3']) or link.find_parent(['h2', 'h3'])
            if heading is None:
                continue
            title = heading.get_text(' ', strip=True)
            if title:
                url = urlunsplit(('https', 'alandsradio.ax', path, '', ''))
                articles.setdefault(url, {'title': title, 'url': url})
        if not articles:
            self.abort_recipe_processing('Hittade inga artiklar på Ålands Radios nyhetssida.')
        return [('Nyheter', list(articles.values())[: self.max_articles_per_feed])]
