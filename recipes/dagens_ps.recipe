from calibre.web.feeds.news import BasicNewsRecipe


class DagensPS(BasicNewsRecipe):
    __author__ = 'Jonatan Nyberg'
    title = 'Dagens PS'
    publisher = 'Dagens PS'
    description = 'Nyheter om ekonomi, börs och privatekonomi från Dagens PS.'
    language = 'sv'
    oldest_article = 3
    max_articles_per_feed = 15
    simultaneous_downloads = 2
    timeout = 30
    auto_cleanup = True
    no_stylesheets = True
    use_embedded_content = False
    ignore_duplicate_articles = {'url'}

    feeds = [
        ('Senaste nytt', 'https://www.dagensps.se/feed/'),
    ]
