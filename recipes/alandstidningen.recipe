from calibre.web.feeds.news import BasicNewsRecipe


class Alandstidningen(BasicNewsRecipe):
    title = 'Ålandstidningen – RSS-översikt'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Ålandstidningen'
    description = 'Rubriker, RSS-text och länkar från Ålandstidningen.'
    language = 'sv'
    encoding = 'utf-8'
    oldest_article = 7
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    timeout = 30
    no_stylesheets = True
    use_embedded_content = True
    remove_empty_feeds = True
    ignore_duplicate_articles = {'url'}

    feeds = [
        ('Senaste nytt', 'https://www.alandstidningen.ax/rss/allt'),
    ]
