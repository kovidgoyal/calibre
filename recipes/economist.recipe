#!/usr/bin/env  python
import json
import time
from datetime import datetime, timedelta
from functools import wraps
from urllib.error import URLError

from html5_parser import parse
from lxml import etree

from calibre.utils.date import local_tz
from calibre.web.feeds.news import BasicNewsRecipe

# The Economist serves the full text of an article to the readers of its mobile
# app and only the opening paragraph to everybody else, and tells the two apart
# by a marker that the app's webview appends to its user agent. Camoufox insists
# on a user agent that matches the rest of the fingerprint it presents, so the
# marker is appended to whatever that user agent turns out to be rather than
# replacing it with one of our own invention, which is both the only thing
# camoufox permits and the only thing that is internally consistent.
APP_USER_AGENT_MARKER = ' Liskov'

# economist.com is behind a bot check that answers a request from a browser it
# has not scored yet with an interstitial page. That page arrives as an HTTP 403
# while its scripts, still running in the tab, do the scoring and then reload
# the page, so a request that gets one is simply made again, by which time the
# check has normally been passed once and for all for the whole browser.
BOT_CHECK_STATUSES = frozenset({403, 429})
BOT_CHECK_RETRIES = 4
BOT_CHECK_DELAY = 5  # seconds


def safe_dict(data, *names):
    ans = data
    for x in names:
        ans = ans.get(x) or {}
    return ans


def bot_check_retrier(fetch):
    """Wrap one of the browser's fetching methods to wait out the bot check."""

    @wraps(fetch)
    def retrying(*args, **kwargs):
        for attempt in range(BOT_CHECK_RETRIES):
            try:
                return fetch(*args, **kwargs)
            except URLError as err:
                last = attempt + 1 >= BOT_CHECK_RETRIES
                if last or getattr(err, 'code', None) not in BOT_CHECK_STATUSES:
                    raise
                time.sleep(BOT_CHECK_DELAY)

    return retrying


def retry_bot_checks(br):
    """Make br retry the requests that the bot check answers with an interstitial.

    Wrapping the methods on the instance rather than subclassing because the
    camoufox browser's own ``clone_browser()`` hands back a plain browser of its
    own class, so every clone has to be wrapped again anyway, which
    :meth:`Economist.clone_browser` does.
    """
    if not getattr(br, 'retries_bot_checks', False):
        for name in ('open', 'open_novisit'):
            setattr(br, name, bot_check_retrier(getattr(br, name)))
        br.retries_bot_checks = True
    return br


def process_web_list(li_node):
    li_html = ''
    for li in li_node['items']:
        if li.get('textHtml'):
            li_html += f'<li>{li["textHtml"]}</li>'
        elif li.get('textJson'):
            li_html += f'<li>{parse_textjson(li["textJson"])}</li>'
        else:
            li_html += f'<li>{li.get("text", "")}</li>'
    return '<ul>' + li_html + '</ul>'


def process_info_box(bx):
    info = ''
    for x in safe_dict(bx, 'components'):
        info += f'<blockquote>{process_web_node(x)}</blockquote>'
    return info


def parse_txt(ty):
    typ = ty.get('type', '')
    children = ty.get('children', [])
    href = '#'
    attributes = ty.get('attributes') or ()
    for a in attributes:
        if a.get('name') == 'href':
            href = a.get('value', href)
            break

    tag_map = {
        'text': lambda: [ty.get('value', '')],
        'scaps': lambda: [
            f'<span style="text-transform: uppercase; font-size: 0.85em; letter-spacing: 0.05em;">{"".join(parse_txt(c))}</span>' for c in children
        ],
        'bold': lambda: [f'<b>{"".join(parse_txt(c))}</b>' for c in children],
        'drop_caps': lambda: [f'<b>{"".join(parse_txt(c))}</b>' for c in children],
        'italic': lambda: [f'<i>{"".join(parse_txt(c))}</i>' for c in children],
        'linebreak': lambda: ['<br>'],
        'external_link': lambda: [f'<a href="{href}">{"".join(parse_txt(c))}</a>' for c in children],
        'internal_link': lambda: [f'<a href="{href}">{"".join(parse_txt(c))}</a>' for c in children],
        'ufinish': lambda: [text for c in children for text in parse_txt(c)],
        'subscript': lambda: [f'<sub>{"".join(parse_txt(c))}</sub>' for c in children],
        'superscript': lambda: [f'<sup>{"".join(parse_txt(c))}</sup>' for c in children],
    }

    if typ in tag_map:
        yield from tag_map[typ]()
    else:
        print('** ', typ)


def parse_textjson(nt):
    return ''.join(''.join(parse_txt(n)) for n in nt)


def process_web_node(node):
    ntype = node.get('type', '')
    if ntype == 'CROSSHEAD':
        if node.get('textHtml'):
            return f'<h4>{node.get("textHtml")}</h4>'
        return f'<h4>{node.get("text", "")}</h4>'
    elif ntype in ['PARAGRAPH', 'BOOK_INFO']:
        if node.get('textHtml'):
            return f'\n<p>{node.get("textHtml")}</p>'
        elif node.get('textJson'):
            return f'\n<p>{parse_textjson(node["textJson"])}</p>'
        return f'\n<p>{node.get("text", "")}</p>'
    elif (ntype == 'IMAGE') or (node.get('__typename', '') == 'ImageComponent'):
        alt = '' if node.get('altText') is None else node.get('altText')
        cap = ''
        if node.get('caption'):
            if node['caption'].get('textHtml') is not None:
                cap = node['caption']['textHtml']
            elif node['caption'].get('textJson') is not None:
                cap = parse_textjson(node['caption']['textJson'])
            elif node['caption'].get('text') is not None:
                cap = node['caption']['text']
        return f'<div><img src="{node["url"]}" title="{alt}"></div><div style="text-align:center; font-size:small;">{cap}</div>'
    elif ntype == 'PULL_QUOTE':
        if node.get('textHtml'):
            return f'<blockquote>{node.get("textHtml")}</blockquote>'
        elif node.get('textJson'):
            return f'<blockquote>{parse_textjson(node["textJson"])}</blockquote>'
        return f'<blockquote>{node.get("text", "")}</blockquote>'
    elif ntype == 'BLOCK_QUOTE':
        if node.get('textHtml'):
            return f'<blockquote><i>{node.get("textHtml")}</i></blockquote>'
        elif node.get('textJson'):
            return f'<blockquote><i>{parse_textjson(node["textJson"])}</i></blockquote>'
        return f'<blockquote><i>{node.get("text", "")}</i></blockquote>'
    elif ntype == 'DIVIDER':
        return '<hr>'
    elif ntype == 'INFOGRAPHIC':
        if node.get('fallback'):
            return process_web_node(node['fallback'])
    elif ntype == 'INFOBOX':
        return process_info_box(node)
    elif ntype == 'UNORDERED_LIST':
        if node.get('items'):
            return process_web_list(node)
    elif ntype:
        print('** ', ntype)
    return ''


def load_article_from_json(next_data):
    body = ''
    page_props = safe_dict(next_data, 'props', 'pageProps')
    data = page_props.get('cp2Content') or page_props.get('content') or {}
    if not data.get('headline'):
        raise ValueError('The __NEXT_DATA__ of this page does not contain an article')

    body += f'<div style="color: red; font-size:small; font-weight:bold;">{data.get("flyTitle", "")}</div>'
    body += f'<h1>{data["headline"]}</h1>'
    if data.get('rubric') and data.get('rubric') is not None:
        body += f'<div style="font-style: italic; color:#202020;">{data.get("rubric", "")}</div>'
    try:
        date = data['dateModified']
    except Exception:
        date = data['datePublished']
    dt = datetime.fromisoformat(date[:-1]) + timedelta(seconds=time.timezone)
    dt = dt.strftime('%b %d, %Y %I:%M %p')
    if data.get('dateline') is None:
        body += f'<p style="color: gray; font-size: small;">{dt}</p>'
    else:
        body += f'<p style="color: gray; font-size: small;">{dt + " | " + (data["dateline"])}</p>'
    main_image_url = safe_dict(data, 'leadComponent') or ''
    if main_image_url:
        body += process_web_node(data['leadComponent'])
    if data.get('byline'):
        if data['byline'] is not None:
            body += f'<p style="color: gray; font-size: small;"><i>{"By " + data["byline"]}</i></p>'
    for node in data.get('body') or ():
        body += process_web_node(node)
    return '<html><body><article>' + body + '</article></body></html>'


class NoArticles(Exception):
    pass


def process_url(url):
    if url.startswith('/'):
        url = 'https://www.economist.com' + url
    return url


def next_data_of(soup, url):
    script_tag = soup.find('script', id='__NEXT_DATA__')
    if script_tag is None:
        raise ValueError(f'No __NEXT_DATA__ in the page at {url}, the site layout has probably changed')
    return json.loads(script_tag.string)


class Economist(BasicNewsRecipe):
    title = 'The Economist'
    language = 'en_GB'
    encoding = 'utf-8'
    masthead_url = 'https://www.livemint.com/lm-img/dev/economist-logo-oneline.png'

    __author__ = 'Kovid Goyal, unkn0wn'
    description = (
        'Global news and current affairs from a European perspective. Uses the camoufox browser, which'
        ' is downloaded on first use, as economist.com blocks every lighter way of fetching its pages.'
    )
    extra_css = '''
        em { color:#202020; }
        img {display:block; margin:0 auto;}
    '''

    resolve_internal_links = True

    # economist.com refuses every other browser, see the module level comments
    # on the bot check and on the user agent
    browser_type = 'camoufox'
    # No delay between requests, deliberately: any delay at all makes calibre
    # download on a single thread, and a browser that navigates to every article
    # is slow enough that an edition then takes well over an hour. Pacing is not
    # what keeps this recipe out of trouble anyway, looking like a real browser
    # is, and each of the download threads gets a tab of its own to do it in.
    delay = 0
    recipe_specific_options = {
        'date': {
            'short': 'The date of the edition to download (YYYY-MM-DD format)',
            'long': 'For example, 2024-07-19',
        },
        'res': {
            'short': 'For hi-res images, select a resolution from the\nfollowing options: 834, 960, 1096, 1280, 1424',
            'long': 'This is useful for non e-ink devices, and for a lower file size\nthan the default, use from 480, 384, 360, 256.',
            'default': '600',
        },
    }

    def get_browser(self, *args, **kwargs):
        br = BasicNewsRecipe.get_browser(self, *args, **kwargs)
        ua = br.user_agent()
        if not ua:
            raise ValueError('The camoufox browser did not report a user agent, so the app marker cannot be appended to it')
        ua += APP_USER_AGENT_MARKER
        # Extra headers are a property of the whole browser, so this marks the
        # requests of every tab. It is done here rather than when the browser is
        # created so that the warmup visits to other sites are made with the
        # browser's own user agent.
        br.addheaders = [(name, value) for name, value in br.addheaders if name.lower() != 'user-agent']
        br.addheaders.append(('User-Agent', ua))
        self.log('Using user agent:', ua)
        return retry_bot_checks(br)

    def clone_browser(self, br):
        # The clone is a browser of camoufox's own class, so it has to be taught
        # about the bot check again
        return retry_bot_checks(BasicNewsRecipe.clone_browser(self, br))

    def canonicalize_internal_url(self, url, is_link=True):
        if url.endswith('/print'):
            url = url.rpartition('/')[0]
        return BasicNewsRecipe.canonicalize_internal_url(self, url, is_link=is_link)

    def publication_date(self):
        edition_date = self.economist_edition_date()
        if edition_date:
            return datetime.strptime(edition_date, '%Y-%m-%d').replace(tzinfo=local_tz)
        try:
            url = self.browser.open('https://www.economist.com/printedition').geturl()
            date_str = url.split('/')[-1]
            return datetime.strptime(date_str, '%Y-%m-%d').replace(tzinfo=local_tz)
        except Exception as e:
            self.log('Failed to fetch publication date from website with error: ' + str(e))
            return super().publication_date()

    def economist_edition_date(self):
        edition_date = self.recipe_specific_options.get('date')
        if isinstance(edition_date, str):
            return edition_date.strip()
        return ''

    def economist_return_index(self, ans):
        if not ans:
            raise NoArticles(
                'Could not find any articles, either the '
                'economist.com server is having trouble and you should '
                'try later or the website format has changed and the '
                'recipe needs to be updated.'
            )
        return ans

    def economist_test_article(self):
        return [('Articles', [{'title': 'test', 'url': 'https://www.economist.com/international/2026/07/23/the-geopolitics-of-air-conditioning'}])]

    def parse_index(self):
        # return self.economist_test_article()
        edition_date = self.economist_edition_date()
        if edition_date:
            url = 'https://www.economist.com/weeklyedition/' + edition_date
            self.timefmt = ' [' + edition_date + ']'
        else:
            url = 'https://www.economist.com/weeklyedition'
        return self.economist_return_index(self.economist_parse_index(url))

    def economist_parse_index(self, url):
        data = next_data_of(self.index_to_soup(url), url)
        # open('/t/raw.json', 'w').write(json.dumps(data, indent=2, sort_keys=True))

        self.description = safe_dict(data, 'props', 'pageProps', 'content', 'headline')
        self.timefmt = ' [' + safe_dict(data, 'props', 'pageProps', 'content', 'formattedIssueDate') + ']'
        self.cover_url = (
            safe_dict(data, 'props', 'pageProps', 'content', 'cover', 'url')
            .replace(
                'economist.com/',
                'economist.com/cdn-cgi/image/width=960,quality=80,format=auto/',
            )
            .replace('SQ_', '')
            .replace('_AS', '_AP')
        )
        self.log('Got cover:', self.cover_url)

        feeds = []
        seen = set()
        for component in safe_dict(data, 'props', 'pageProps', 'content', 'components'):
            match component.get('type'):
                case 'AD':
                    continue
                case 'COLLECTION':
                    articles = []
                    section = component['name']
                    self.log(section)
                    for article in component['articles']:
                        if article['id'] in seen:
                            continue
                        seen.add(article['id'])
                        title = article['headline']
                        url = process_url(article['url'])
                        sub = article.get('flyTitle') or ''
                        desc = article.get('rubric') or ''
                        if sub and section != sub:
                            desc = sub + ' :: ' + desc
                        self.log('\t', title, '\n\t', desc, '\n\t\t', url)
                        articles.append({'title': title, 'url': url, 'description': desc})
                    if articles:
                        feeds.append((section, articles))

        return feeds

    def preprocess_html(self, soup):
        width = '600'
        w = self.recipe_specific_options.get('res')
        if w and isinstance(w, str):
            width = w
        for img in soup.findAll('img', src=True):
            qua = 'economist.com/cdn-cgi/image/width=' + width + ',quality=80,format=auto/'
            img['src'] = img['src'].replace('economist.com/', qua)
        return soup

    def preprocess_raw_html(self, raw_html, url):
        # open('/t/raw.html', 'wb').write(raw.encode('utf-8'))
        if '/interactive/' in url:
            return '<html><body><article><h1>Article not available.</h1><em>This article is supposed to be read in a browser.</em></article></body></html>'
        root_ = parse(raw_html)
        script = root_.xpath('//script[@id="__NEXT_DATA__"]')
        if not script:
            raise ValueError(f'No __NEXT_DATA__ in the article at {url}, the site layout has probably changed')
        next_data = json.loads(script[0].text)
        if safe_dict(next_data, 'props', 'pageProps').get('walled'):
            self.log.warn(f'{url} was served paywalled, only its opening paragraph will be in the output')
        html = load_article_from_json(next_data)
        root = parse(html)

        for x in root.xpath('//*[name()="script" or name()="style" or name()="source" or name()="meta"]'):
            x.getparent().remove(x)
        # the economist uses <small> for small caps with a custom font
        for init in root.xpath('//span[@data-caps="initial"]'):
            init.set('style', 'font-weight:bold;')
        for x in root.xpath('//small'):
            if x.text and len(x) == 0:
                x.text = x.text.upper()
                x.tag = 'span'
                x.set(
                    'style',
                    'text-transform: uppercase; font-size: 0.85em; letter-spacing: 0.05em;',
                )
        for h2 in root.xpath('//h2'):
            h2.tag = 'h4'
        for x in root.xpath('//figcaption'):
            x.set('style', 'text-align:center; font-size:small;')
        for x in root.xpath('//cite'):
            x.tag = 'blockquote'
            x.set('style', 'color:#404040;')
        raw = etree.tostring(root, encoding='unicode')
        return raw
