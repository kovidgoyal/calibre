import re
from urllib.parse import urljoin, urlsplit, urlunsplit

from calibre.web.feeds.news import BasicNewsRecipe


class Verkkouutiset(BasicNewsRecipe):
    title = 'Verkkouutiset'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Verkkouutiset'
    description = 'Kokoomuksen äänenkannattajan uutisia ja näkökulmia politiikasta, taloudesta ja maailmalta.'
    language = 'fi'
    encoding = 'utf-8'
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    delay = 1
    timeout = 30
    auto_cleanup = True
    no_stylesheets = True
    use_embedded_content = False
    ignore_duplicate_articles = {'url'}

    def parse_index(self):
        index_url = 'https://www.verkkouutiset.fi/'
        soup = self.index_to_soup(index_url)
        main = soup.find('main') or soup.find(attrs={'role': 'main'}) or soup
        articles = {}
        for link in main.find_all('a', href=True):
            parsed = urlsplit(urljoin(index_url, link['href']))
            if parsed.scheme != 'https' or parsed.netloc not in {'www.verkkouutiset.fi', 'verkkouutiset.fi'}:
                continue
            if not re.fullmatch(r'/a/[^/]+/?', parsed.path):
                continue
            # The homepage's TV and blog blocks use h6; news and viewpoints use h1-h5.
            heading = link.find(['h1', 'h2', 'h3', 'h4', 'h5']) or link.find_parent(['h1', 'h2', 'h3', 'h4', 'h5'])
            if heading is None:
                continue
            title = heading.get_text(' ', strip=True)
            if title:
                url = urlunsplit(('https', 'www.verkkouutiset.fi', parsed.path.rstrip('/') + '/', '', ''))
                articles.setdefault(url, {'title': title, 'url': url})
        if not articles:
            self.abort_recipe_processing('Verkkouutisten etusivulta ei löytynyt artikkeleita.')
        return [('Uutiset ja näkökulmat', list(articles.values())[: self.max_articles_per_feed])]
