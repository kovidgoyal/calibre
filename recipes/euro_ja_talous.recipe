import re
from urllib.parse import urljoin, urlsplit, urlunsplit

from calibre.web.feeds.news import BasicNewsRecipe


class EuroJaTalous(BasicNewsRecipe):
    __author__ = 'Jonatan Nyberg'
    title = 'Euro & talous'
    publisher = 'Suomen Pankki'
    description = 'Suomen Pankin talousartikkeleita ja blogeja etusivun ajankohtaisista nostoista.'
    language = 'fi'
    encoding = 'utf-8'
    max_articles_per_feed = 20
    simultaneous_downloads = 2
    delay = 1
    timeout = 30
    auto_cleanup = True
    no_stylesheets = True
    use_embedded_content = False
    ignore_duplicate_articles = {'url'}
    index_url = 'https://www.eurojatalous.fi/'

    def parse_index(self):
        soup = self.index_to_soup(self.index_url)
        main = soup.find('main') or soup.find(attrs={'role': 'main'}) or soup
        articles = {}
        for link in main.find_all('a', href=True):
            parsed = urlsplit(urljoin(self.index_url, link['href']))
            if (
                parsed.scheme != 'https'
                or parsed.netloc not in {'www.eurojatalous.fi', 'eurojatalous.fi'}
                or not re.fullmatch(r'/(?:blogit/\d{4}|artikkeli/[^/]+/\d{4})/[^/]+/?', parsed.path)
            ):
                continue
            heading = link.find(['h2', 'h3', 'h4']) or link.find_parent(['h2', 'h3', 'h4'])
            title = (heading or link).get_text(' ', strip=True)
            url = urlunsplit(('https', 'www.eurojatalous.fi', parsed.path.rstrip('/') + '/', '', ''))
            if title and (heading or url not in articles):
                articles[url] = {'title': title, 'url': url}

        if not articles:
            self.abort_recipe_processing('Euro & talous -sivustolta ei löytynyt artikkeleita.')
        return [('Artikkelit ja blogit', list(articles.values())[: self.max_articles_per_feed])]
