from calibre.web.feeds.news import BasicNewsRecipe


class NyaOstis(BasicNewsRecipe):
    title = 'Nya Östis – RSS-översikt'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Nya Östis'
    description = 'Rubriker, RSS-text och länkar från Nya Östis i östra Nyland.'
    language = 'sv'
    encoding = 'utf-8'
    oldest_article = 14
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    timeout = 30
    no_stylesheets = True
    use_embedded_content = True
    remove_empty_feeds = True
    ignore_duplicate_articles = {'url'}

    feeds = [
        ('Senaste nytt', 'https://www.nyaostis.fi/feed/'),
    ]
