import re
from urllib.parse import urljoin, urlsplit, urlunsplit

from calibre.web.feeds.news import BasicNewsRecipe


class Selkosanomat(BasicNewsRecipe):
    title = 'Selkosanomat'
    __author__ = 'Jonatan Nyberg'
    publisher = 'Selkokeskus'
    description = 'Suomen ja maailman uutisia selkosuomeksi Selkosanomien etusivulta.'
    language = 'fi'
    encoding = 'utf-8'
    max_articles_per_feed = 30
    simultaneous_downloads = 2
    timeout = 30
    auto_cleanup = True
    no_stylesheets = True
    use_embedded_content = False
    ignore_duplicate_articles = {'url'}

    def parse_index(self):
        index_url = 'https://selkosanomat.fi/'
        soup = self.index_to_soup(index_url)
        articles = {}
        for link in soup.find_all('a', href=True):
            parsed = urlsplit(urljoin(index_url, link['href']))
            if parsed.scheme != 'https' or parsed.netloc not in {'selkosanomat.fi', 'www.selkosanomat.fi'}:
                continue
            if not re.fullmatch(r'/(?:suomi|maailma|urheilu|kulttuuri|arki|paakirjoitus|viikon-kuva)/[^/]+/?', parsed.path):
                continue
            heading = link.find(['h2', 'h3']) or link.find_parent(['h2', 'h3'])
            if heading is None:
                continue
            title = heading.get_text(' ', strip=True)
            if title:
                url = urlunsplit(('https', 'selkosanomat.fi', parsed.path.rstrip('/') + '/', '', ''))
                articles.setdefault(url, {'title': title, 'url': url})
        if not articles:
            self.abort_recipe_processing('Selkosanomien etusivulta ei löytynyt artikkeleita.')
        return [('Uusimmat uutiset', list(articles.values())[: self.max_articles_per_feed])]
