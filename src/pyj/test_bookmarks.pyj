from __python__ import hash_literals

from elementmaker import E

from modals import close_all_modals, create_modal_container
from read_book.annotations import AnnotationsManager, merge_annotation_maps
from read_book.bookmarks import create_bookmarks_list
from testing import assert_equal, assert_false, assert_true, test


OLD_TIMESTAMP = '2020-01-01T00:00:00.000Z'


def initial_bookmarks():
    return [{'title': title, 'pos': '/' + title, 'type': 'bookmark', 'timestamp': OLD_TIMESTAMP} for title in ['First', 'Middle', 'Last']]


def with_bookmarks(proceed):
    manager = AnnotationsManager(None)
    manager.set_bookmarks(initial_bookmarks())
    create_modal_container()
    fallback = E.button('New bookmark')
    document.body.appendChild(fallback)
    container = create_bookmarks_list(manager, def (): pass;, fallback)
    document.body.appendChild(container)
    previous = window.prompt
    try:
        proceed(manager, container, fallback)
    finally:
        window.prompt = previous
        close_all_modals()


def live_titles(manager):
    return sorted([b.title for b in manager.all_bookmarks() if not b.removed])


def modal_is_shown():
    return document.getElementById('modal-container').style.display is 'flex'


def answer_question(yes):
    assert_true(modal_is_shown())
    buttons = document.querySelectorAll('#modal-container .button-box a')
    buttons[1 if yes else 0].click()


def row_buttons(row):
    return row.querySelectorAll('button.item-side-action')


@test
def bookmark_actions_use_the_title_after_a_rename():
    def run(manager, container, fallback):
        edit = row_buttons(container.querySelector('li'))[1]
        window.prompt = def (): return 'Renamed'
        edit.focus()
        edit.click()
        window.prompt = def (): return 'Renamed again'
        edit.click()
        assert_equal(live_titles(manager), ['Last', 'Middle', 'Renamed again'])
        assert_equal(container.querySelector('.item-title').textContent, 'Renamed again')
        assert_equal(document.activeElement, edit)
        row_buttons(container.querySelector('li'))[0].click()
        answer_question(True)
        assert_equal(live_titles(manager), ['Last', 'Middle'])

    with_bookmarks(run)


@test
def bookmark_rename_to_an_existing_title_is_rejected():
    def run(manager, container, fallback):
        first = container.querySelector('li')
        window.prompt = def (): return 'Last'
        row_buttons(first)[1].click()
        assert_true(modal_is_shown())
        assert_equal(live_titles(manager), ['First', 'Last', 'Middle'])
        assert_equal(first.querySelector('.item-title').textContent, 'First')
        close_all_modals()
        # A removed bookmark with the title does not block the rename and is
        # replaced, while the old title is kept as a removed bookmark
        manager.remove_bookmark('Last')
        row_buttons(first)[1].click()
        assert_false(modal_is_shown())
        assert_equal(live_titles(manager), ['Last', 'Middle'])
        assert_equal([b.title for b in manager.all_bookmarks() if b.removed], ['First'])

    with_bookmarks(run)


@test
def bookmark_delete_moves_focus_to_surviving_rows_then_the_new_bookmark_control():
    def run(manager, container, fallback):
        first, middle, last = container.querySelectorAll('li')

        def delete_row(row, yes):
            trash = row_buttons(row)[0]
            trash.focus()
            trash.click()
            answer_question(yes)

        delete_row(middle, False)
        assert_true(middle.getClientRects().length > 0)
        assert_equal(document.activeElement, row_buttons(middle)[0])
        delete_row(middle, True)
        assert_equal(middle.style.display, 'none')
        assert_equal(document.activeElement, row_buttons(last)[0])
        delete_row(last, True)
        assert_equal(document.activeElement, row_buttons(first)[0])
        delete_row(first, True)
        assert_equal(document.activeElement, fallback)
        assert_equal(live_titles(manager), [])

    with_bookmarks(run)


@test
def bookmark_delete_hides_the_row_even_if_the_bookmark_has_gone():
    def run(manager, container, fallback):
        manager.set_bookmarks([])
        row = container.querySelector('li')
        row_buttons(row)[0].click()
        answer_question(True)
        assert_equal(row.style.display, 'none')
        assert_false(manager.all_bookmarks().length)

    with_bookmarks(run)


@test
def bookmark_rename_removes_the_old_title_when_merged_with_another_copy():
    def run(manager, container, fallback):
        window.prompt = def (): return 'Renamed'
        middle = container.querySelectorAll('li')[2]
        assert_equal(middle.querySelector('.item-title').textContent, 'Middle')
        row_buttons(middle)[1].click()
        assert_equal(live_titles(manager), ['First', 'Last', 'Renamed'])
        renamed = [b for b in manager.all_bookmarks() if b.title is 'Renamed'][0]
        assert_equal(renamed.pos, '/Middle')
        # The server still has the bookmarks from before the rename
        updated, merged = merge_annotation_maps({'bookmark': initial_bookmarks()}, {'bookmark': manager.all_bookmarks().as_array()})
        assert_true(updated)
        assert_equal(sorted([b.title for b in merged.bookmark if not b.removed]), ['First', 'Last', 'Renamed'])
        assert_equal([b.title for b in merged.bookmark if b.removed], ['Middle'])

    with_bookmarks(run)
