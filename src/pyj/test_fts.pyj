from __python__ import hash_literals

from elementmaker import E
from gettext import gettext as _, ngettext

from book_list.fts import apply_search_panel_state, component, init, restore_result_focus, set_search_status, show_index_panel
from book_list.globals import get_current_query
from modals import close_all_modals, create_modal_container, show_modal
from test_book_list_helpers import with_empty_session
from testing import assert_equal, assert_false, assert_true, test
from utils import parse_url_params


def with_search_panel(proceed):
    def run(sd):
        previous_url = window.location.href
        previous_query = get_current_query()
        previous_xhr = window.XMLHttpRequest
        requests = []
        q = {'panel': 'fts', 'library_id': 'test'}

        def make_xhr():
            xhr = E.div()
            xhr.open = def (method, path): pass
            xhr.send = def (): requests.push(xhr)
            xhr.abort = def ():
                xhr.aborted = True
                xhr.dispatchEvent(new Event('abort'))
            xhr.status = 200
            xhr.statusText = 'OK'
            return xhr

        def search(query):
            q.fts_query = query
            apply_search_panel_state()
            return requests[-1]

        def fail(xhr, status):
            xhr.status = status
            xhr.responseText = ''
            xhr.dispatchEvent(new Event('load'))

        def finish(xhr, books=None, left=0, total=0):
            query_id = new window.URL(xhr.request_path, window.location.href).searchParams.get('query_id')
            xhr.responseText = JSON.stringify({
                'query_id': query_id, 'indexing_status': {'left': left, 'total': total},
                'results': [{'book_id': bid, 'format': 'EPUB'} for bid in (books or [])],
                'metadata': {1: {'title': 'First', 'authors': 'Author'}, 2: {'title': 'Second', 'authors': 'Author'}},
            })
            xhr.dispatchEvent(new Event('load'))

        try:
            window.XMLHttpRequest = make_xhr
            window.history.replaceState(None, '', '#panel=fts&library_id=test')
            parse_url_params.cache = {}
            get_current_query(q)
            document.body.appendChild(E.div(id='test-fts'))
            init('test-fts')

            proceed(search, finish, requests, fail)
        finally:
            window.XMLHttpRequest = previous_xhr
            window.history.replaceState(None, '', previous_url)
            parse_url_params.cache = {}
            get_current_query(previous_query or {})

    with_empty_session(run)


def found(n):
    return ngettext('{} book found', '{} books found', n).format(n)


@test
def fts_result_covers_are_native_buttons_outside_snippets():
    def run(search, finish, requests):
        finish(search('test'), [1, 2])
        results = component('results')
        buttons = results.querySelectorAll('.fts-result-cover')
        assert_equal(buttons.length, 2)
        button = buttons[0]
        assert_equal(button.tagName, 'BUTTON')
        assert_equal(button.type, 'button')
        assert_equal(button.getAttribute('aria-haspopup'), 'dialog')
        assert_equal(button.getAttribute('aria-label'), 'First ' + _('by') + ' Author')
        assert_equal(button.textContent, '')
        img = button.querySelector('img')
        assert_true(img)
        assert_equal(img.alt, '')
        assert_false(button.querySelector('.snippets_container'))
        # No visible title is added, the snippets column only holds snippets
        assert_equal(results.querySelector('.snippets_container').parentNode.childElementCount, 1)
        button.focus()
        snippets = requests[-1]
        query_id = new window.URL(snippets.request_path, window.location.href).searchParams.get('query_id')
        snippets.responseText = JSON.stringify({'query_id': query_id, 'snippets': {1: [{'formats': ['EPUB'], 'text': 'A match'}], 2: []}})
        snippets.dispatchEvent(new Event('load'))
        assert_equal(results.querySelector('.fts-result-cover'), button)
        assert_equal(document.activeElement, button)
        assert_true(results.querySelector('.snippets_container').textContent.indexOf('A match') > -1)

    with_search_panel(run)


@test
def fts_result_focus_is_restored_only_for_current_visible_results():
    def run(search, finish):
        finish(search('test'), [1])
        button = component('results').querySelector('.fts-result-cover')
        input = component('query').querySelector('input')
        # Focusing the button must not scroll a tile's snippets back to the
        # top, so it must not be inside the scrollable snippets column
        column = component('results').querySelector('.snippets_container').parentNode
        assert_equal(window.getComputedStyle(column).overflowY, 'auto')
        assert_false(column.contains(button))
        input.focus()
        restore_result_focus(button, 'test-fts')
        assert_equal(document.activeElement, button)
        input.focus()
        create_modal_container()
        show_modal(def (container, close_modal):
            container.textContent = 'dialog'
        )
        input.focus()
        restore_result_focus(button, 'test-fts')
        assert_equal(document.activeElement, input)
        close_all_modals()
        input.focus()
        get_current_query().mode = 'read_book'
        restore_result_focus(button, 'test-fts')
        assert_equal(document.activeElement, input)
        get_current_query().mode = 'book_list'
        show_index_panel()
        restore_result_focus(button, 'test-fts')
        assert_equal(document.activeElement, input)
        search('replacement')
        assert_false(button.isConnected)
        restore_result_focus(button, 'test-fts')
        assert_equal(document.activeElement, input)

    with_search_panel(run)


@test
def fts_status_counts_books_and_preserves_focus():
    def run(search, finish, requests):
        status = component('status')
        assert_equal(status.getAttribute('role'), 'status')
        assert_equal(status.getAttribute('aria-atomic'), 'true')
        assert_equal(status.textContent, '')
        input = component('query').querySelector('input')
        input.focus()
        xhr = search('test')
        assert_true(status.textContent.indexOf('test') > -1)
        finish(xhr, [1, 1, 2])
        assert_equal(status.textContent, found(2))
        assert_equal(component('status'), status)
        assert_equal(document.activeElement, input)
        observer = new window.MutationObserver(def (): pass;)
        observer.observe(status, {'childList': True, 'subtree': True, 'characterData': True})
        try:
            set_search_status(found(2))
            apply_search_panel_state()
            snippets = requests[-1]
            query_id = new window.URL(snippets.request_path, window.location.href).searchParams.get('query_id')
            snippets.responseText = JSON.stringify({'query_id': query_id, 'snippets': {1: [], 2: []}})
            snippets.dispatchEvent(new Event('load'))
            assert_equal(observer.takeRecords().length, 0)
        finally:
            observer.disconnect()
        finish(search('one'), [1])
        assert_equal(status.textContent, found(1))
        finish(search('none'))
        assert_equal(status.textContent, _('No matches found'))

    with_search_panel(run)


@test
def fts_status_ignores_superseded_and_hidden_searches():
    def run(search, finish):
        old = search('old')
        current = search('current')
        status = component('status')
        waiting = status.textContent
        finish(old, [1])
        assert_equal(status.textContent, waiting)
        old.status = 500
        old.dispatchEvent(new Event('load'))
        assert_equal(status.textContent, waiting)
        assert_false(document.getElementById('modal-container'))
        finish(current)
        assert_equal(status.textContent, _('No matches found'))
        hidden = search('hidden')
        waiting = status.textContent
        show_index_panel()
        finish(hidden, [1, 2])
        assert_equal(status.textContent, waiting)

    with_search_panel(run)


@test
def fts_status_ignores_reader_and_removed_panels():
    def run(search, finish):
        xhr = search('reader')
        status = component('status')
        waiting = status.textContent
        q = get_current_query()
        q.mode = 'read_book'
        finish(xhr, [1])
        assert_equal(status.textContent, waiting)
        q.mode = 'book_list'
        xhr = search('removed')
        waiting = status.textContent
        document.getElementById('test-fts').remove()
        finish(xhr, [1])
        assert_equal(status.textContent, waiting)

    with_search_panel(run)


@test
def fts_status_restarts_pending_search_when_panel_is_recreated():
    def run(search, finish):
        old = search('pending')
        host = document.getElementById('test-fts')
        host.remove()
        document.body.appendChild(E.div(id='test-fts-reopened'))
        init('test-fts-reopened')
        status = component('status')
        waiting = status.textContent
        finish(old, [1])
        assert_equal(status.textContent, waiting)
        finish(search('pending'), [1, 2])
        assert_equal(status.textContent, found(2))

    with_search_panel(run)


@test
def fts_status_warns_about_incomplete_indexing_and_clears_with_query():
    def run(search, finish):
        status = component('status')
        finish(search('partial'), [1], left=5, total=10)
        assert_true(status.textContent.startsWith(found(1)))
        assert_true(status.textContent.indexOf('50%') > -1)
        pending = search('clear')
        search('')
        assert_equal(status.textContent, '')
        finish(pending, [1])
        assert_equal(status.textContent, '')
        assert_true(component('results').querySelector('.fts-help-display'))

    with_search_panel(run)


@test
def fts_failed_search_is_shown_and_announced():
    def run(search, finish, requests, fail):
        create_modal_container()
        status = component('status')
        fail(search('broken'), 500)
        assert_equal(status.textContent, _('Search failed'))
        assert_equal(component('results').textContent, _('Search failed'))
        fail(search('disabled'), 428)
        assert_equal(status.textContent, _('Full text searching disabled'))
        assert_equal(component('results').textContent, _('Full text searching disabled'))
        close_all_modals()

    with_search_panel(run)


@test
def fts_superseded_search_is_aborted():
    def run(search, finish):
        old = search('old')
        current = search('current')
        assert_true(old.aborted)
        assert_false(current.aborted)
        search('')
        assert_true(current.aborted)

    with_search_panel(run)


@test
def fts_status_set_while_building_panel_is_delayed():
    def run(search, finish):
        search('pending')
        document.getElementById('test-fts').remove()
        document.body.appendChild(E.div(id='test-fts-reopened'))
        init('test-fts-reopened')
        # Changes made in the same task that inserts the live region are not
        # announced, so the update is delayed
        assert_equal(component('status').textContent, '')
        assert_true(component('results').textContent.indexOf('pending') > -1)

    with_search_panel(run)
