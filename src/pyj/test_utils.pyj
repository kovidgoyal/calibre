from __python__ import bound_methods, hash_literals

from complete import EditWithComplete
from dom import create_live_region, set_live_region_text
from modals import close_all_modals, create_modal_container, is_modal_visible, show_modal
from session import deep_eq
from testing import assert_equal, assert_false, assert_true, test
from utils import fmt_sidx, human_readable, rating_to_stars
from widgets import create_button


@test
def misc_utils():
    assert_equal(rating_to_stars(3, True), '★⯨')
    assert_equal(fmt_sidx(10), 'X')
    assert_equal(fmt_sidx(1.2), '1.20')
    assert_equal(list(map(human_readable, [1, 1024.0, 1025, 1024 * 1024 * 2.3])), ['1 B', '1 KB', '1 KB', '2.3 MB'])
    assert_equal(False, deep_eq({'portrait': 0, 'landscape': 0}, {'landscape': 3, 'portrait': 0}))
    assert_equal(False, deep_eq(1, 2))
    assert_equal(True, deep_eq(1, 1))


@test
def live_region_updates_are_delayed_cancellable_and_not_repeated():
    region = create_live_region()
    assert_equal(region.getAttribute('role'), 'status')
    assert_equal(region.getAttribute('aria-atomic'), 'true')
    timers = []
    previous = window.setTimeout
    window.setTimeout = def (callback):
        timers.push(callback)

    def flush():
        while timers.length:
            timers.shift()()

    document.body.appendChild(region)
    try:
        set_live_region_text(region, 'now')
        assert_equal(region.textContent, 'now')
        set_live_region_text(region, 'first', True)
        set_live_region_text(region, 'second', True)
        assert_equal(region.textContent, 'now')
        flush()
        assert_equal(region.textContent, 'second')
        set_live_region_text(region, 'pending', True)
        set_live_region_text(region, '', True)
        assert_equal(region.textContent, '')
        flush()
        assert_equal(region.textContent, '')
        set_live_region_text(region, 'unwanted', True, def (): return False;)
        flush()
        assert_equal(region.textContent, '')
        set_live_region_text(region, 'detached', True)
        region.remove()
        flush()
        assert_equal(region.textContent, '')
    finally:
        window.setTimeout = previous
        region.remove()


@test
def completion_announces_replaced_text_with_a_change_event():
    parent = document.createElement('div')
    document.body.appendChild(parent)
    ewc = EditWithComplete('test-completion', parent=parent)
    try:
        changes = []
        ewc.text_input.addEventListener('change', def (ev):
            changes.push(ev.currentTarget.value)
        )
        assert_true(ewc.apply_completion('first'))
        assert_equal(changes, ['first'])
        # Applying the text the input already has changes nothing
        ewc.apply_completion('first')
        assert_equal(changes, ['first'])
        assert_false(ewc.apply_completion(''))
        assert_equal(changes, ['first'])
    finally:
        ewc.hide_completion_popup()
        parent.remove()


@test
def modal_visibility_follows_shown_dialogs():
    create_modal_container()
    assert_false(is_modal_visible())
    try:
        show_modal(def (container, close_modal):
            container.textContent = 'dialog'
        )
        assert_true(is_modal_visible())
        close_all_modals()
        assert_false(is_modal_visible())
    finally:
        close_all_modals()


@test
def push_buttons_are_activated_by_space_like_native_buttons():
    clicks = []
    b = create_button('Text', action=def (ev):
        clicks.push(ev.type)
    )
    document.body.appendChild(b)

    def key(kind, key, kw):
        ev = new window.KeyboardEvent(kind, Object.assign({'key': key, 'bubbles': True, 'cancelable': True}, kw))
        b.dispatchEvent(ev)
        return ev

    try:
        assert_equal(b.getAttribute('role'), 'button')
        # Space activates on release, and does not scroll the page
        assert_true(key('keydown', ' ').defaultPrevented)
        assert_equal(clicks, [])
        assert_true(key('keyup', ' ').defaultPrevented)
        assert_equal(clicks, ['click'])
        # A release without a press, such as after Space was pressed
        # elsewhere, does nothing
        key('keyup', ' ')
        assert_equal(clicks, ['click'])
        # Losing focus between press and release cancels
        key('keydown', ' ')
        b.dispatchEvent(new Event('blur'))
        key('keyup', ' ')
        assert_equal(clicks, ['click'])
        # Space with a modifier is left alone
        assert_false(key('keydown', ' ', {'ctrlKey': True}).defaultPrevented)
        key('keyup', ' ', {'ctrlKey': True})
        assert_equal(clicks, ['click'])
        # Other keys, including Enter, which activates the link natively,
        # are left alone
        assert_false(key('keydown', 'Enter').defaultPrevented)
        assert_false(key('keydown', 'a').defaultPrevented)
        assert_equal(clicks, ['click'])
    finally:
        b.remove()
